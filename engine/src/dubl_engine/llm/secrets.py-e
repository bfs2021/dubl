"""Ключи моделей — только в системной связке ключей (keyring): service="dubl", username=provider_id.

Нигде больше ключи не хранятся (ни в settings.json, ни в логах). Если связки ключей нет
(например, Linux без secret service) — понятная ошибка, а не запись в открытый файл.

Связку ключей читаем как можно реже: на macOS каждое чтение чужим процессом (а python из нейросетевого
окружения для связки — «чужой») может вызвать окно «python3.11 хочет использовать…». Поэтому:
  · прочитанный ключ держим в памяти процесса до перезапуска движка;
  · «есть ли ключ» (для экрана настроек) берём из списка <data_dir>/keys_present.json — без самих ключей.
"""
from __future__ import annotations

import json
import logging
import threading

from ..util import EngineError

log = logging.getLogger(__name__)

SERVICE = "dubl"

_NO_KEYRING = (
    "В системе нет связки ключей, поэтому ключ негде безопасно сохранить. "
    "Установите её (в Linux — gnome-keyring или KWallet) или используйте Claude CLI, которому ключ не нужен."
)

_lock = threading.Lock()
_cache: dict[str, str | None] = {}      # provider_id → ключ (None — точно нет); живёт до перезапуска движка


def _backend_ok() -> None:
    import keyring
    from keyring.backends import fail, null

    kr = keyring.get_keyring()
    # fail/null-бэкенды: первый бросает ошибку, второй молча «сохраняет в никуда» — оба нам не подходят
    if isinstance(kr, (fail.Keyring, null.Keyring)):
        raise EngineError(_NO_KEYRING)


def _wrap(exc: Exception) -> EngineError:
    return EngineError(f"{_NO_KEYRING} ({type(exc).__name__})")


# ── список «у кого есть ключ» (без самих ключей) ──
def _present_path():
    from ..util import data_dir
    return data_dir() / "keys_present.json"


def _load_present() -> dict[str, bool] | None:
    try:
        data = json.loads(_present_path().read_text(encoding="utf-8"))
        return {str(k): bool(v) for k, v in data.items()} if isinstance(data, dict) else None
    except (OSError, ValueError):
        return None


def _mark_present(provider_id: str, present: bool) -> None:
    from ..store.atomic import atomic_write_text
    data = _load_present() or {}
    if data.get(provider_id) == present:
        return
    data[provider_id] = present
    try:
        atomic_write_text(_present_path(), json.dumps(data, ensure_ascii=False))
    except OSError as e:               # это подсказка для экрана, а не данные — не роняем запрос
        log.warning("Не удалось записать keys_present.json: %s", e)


def set_key(provider_id: str, key: str) -> None:
    key = (key or "").strip()
    if not provider_id:
        raise EngineError("Не указано, для какой модели ключ.")
    if not key:
        raise EngineError("Ключ пустой.")
    import keyring
    from keyring.errors import KeyringError

    _backend_ok()
    try:
        keyring.set_password(SERVICE, provider_id, key)
    except KeyringError as e:
        raise _wrap(e) from None
    with _lock:
        _cache[provider_id] = key
        _mark_present(provider_id, True)


def get_key(provider_id: str) -> str | None:
    with _lock:
        if provider_id in _cache:
            return _cache[provider_id]
        present = (_load_present() or {}).get(provider_id)
    if present is False:               # ключа точно нет — в связку не ходим
        return None
    import keyring
    from keyring.errors import KeyringError

    _backend_ok()
    try:
        value = keyring.get_password(SERVICE, provider_id) or None
    except KeyringError as e:
        raise _wrap(e) from None
    with _lock:
        _cache[provider_id] = value
        _mark_present(provider_id, value is not None)
    return value


def delete_key(provider_id: str) -> None:
    """Удалить ключ. Если ключа не было — ничего не делает."""
    import keyring
    from keyring.errors import KeyringError, PasswordDeleteError

    _backend_ok()
    try:
        keyring.delete_password(SERVICE, provider_id)
    except PasswordDeleteError:
        pass
    except KeyringError as e:
        raise _wrap(e) from None
    with _lock:
        _cache[provider_id] = None
        _mark_present(provider_id, False)


def has_key(provider_id: str) -> bool:
    """Есть ли ключ. Не бросает и, если это уже известно, не трогает связку ключей."""
    with _lock:
        if provider_id in _cache:
            return _cache[provider_id] is not None
        present = (_load_present() or {}).get(provider_id)
    if present is not None:
        return present
    try:                               # ключи, сохранённые до появления keys_present.json: один раз спросим связку
        return get_key(provider_id) is not None
    except EngineError:
        return False


def _reset_cache_for_tests() -> None:
    with _lock:
        _cache.clear()
